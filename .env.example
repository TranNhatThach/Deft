# ============================================
# Backend Environment Variables (backend-deft)
# ============================================
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String
DATABASE_URL=postgresql://deft_user:deft_password_secret_change_me@localhost:5432/deft_db?schema=public

# JWT Security Secrets (Use strong random strings in production!)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_change_in_prod
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL=900000
AUTH_THROTTLE_LIMIT=5

# ============================================
# Mobile Frontend Environment Variables (mobile-deft)
# Note: ONLY public-safe variables starting with EXPO_PUBLIC_ should be exposed to client.
# NO JWT SECRETS OR DATABASE CREDENTIALS IN MOBILE!
# ============================================
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
EXPO_PUBLIC_USE_MOCK=false
